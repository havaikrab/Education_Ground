SECRET_KEY= # Здесь должен находиться ваш секретный Django-ключ

# Параметры подключения к базе данных
DB_NAME= # Название БД
DB_USER= # Имя пользователя БД
DB_PASSWORD= # Пароль пользователя БД
DB_HOST= # Хост подключаемой БД
DB_PORT= # Порт подключения БД

# Параметры токенов авторизации
ACCESS_TOKEN_LIFETIME= # Срок годности access-токена в минутах, по умолчанию устанавливается 5
REFRESH_TOKEN_LIFETIME= # Срок годности refresh-токена в сутках, по умолчанию устанавливается 1

# Stripe-ключи
STRIPE_RESTRICTED_KEY= # личный секретный ключ для API сервиса Stripe
STRIPE_WEBHOOK_SECRET= # вебхук-секрет сервиса Stripe

# Параметры Redis
REDIS_HOST= # Хост подключения к брокеру Redis, по умолчанию используется 127.0.0.1
REDIS_PORT= # Порт подключения к брокеру Redis, по умолчанию используется 6379

# Настройки Celery
CELERY_BROKER_DB= # Номер базы данных Redis для воркера Celery, по умолчанию используется 1
CELERY_RESULT_DB= # Номер базы данных Redis для хранения результатов работы Celery, по умолчанию используется 1
CELERY_TASK_TRACK_STARTED= # Флаг отслеживания выполнения задач, по умолчанию используется true
CELERY_TASK_TIME_LIMIT= # Предел времени для обработки одной задачи в секундах, по умолчанию используется 1800 (1/2 часа)
