SECRET_KEY= # Здесь должен находиться ваш секретный Django-ключ
    # если у вас нет ключа, он сгенерируется автоматически, просто не указывайте эту переменную в файле .env

DEBUG= # Флаг запуска сервера в режиме разработки, использовать True для отладки

CURRENT_SITE= # Доменное имя, с которым запущен проект, по умолчанию используется http://localhost:8000

# Параметры подключения к базе данных
DB_NAME= # Название БД, по умолчанию устанавливается postgres
DB_USER= # Имя пользователя БД, по умолчанию устанавливается postgres
DB_PASSWORD= # Пароль пользователя БД, по умолчанию остается пустой строкой
DB_HOST= # Хост БД для локальной разработки. При запуске docker-контейнера КЛЮЧ НЕ УКАЗЫВАТЬ в переменных окружения, по умолчанию используется значение db
DB_PORT= # Порт БД для локальной разработки. При запуске docker-контейнера КЛЮЧ НЕ УКАЗЫВАТЬ в переменных окружения, по умолчанию используется значение 5432

# Параметры часового пояса, в котором расположен сервер
LOCAL_TIME_ZONE= # Название местного часового пояса, например: Europe/Moscow. По умолчанию используется America/Chicago

# Параметры токенов авторизации
ACCESS_TOKEN_LIFETIME= # Срок годности access-токена в минутах, по умолчанию устанавливается 5
REFRESH_TOKEN_LIFETIME= # Срок годности refresh-токена в сутках, по умолчанию устанавливается 1

# Stripe-ключи
STRIPE_RESTRICTED_KEY= # личный секретный ключ для API сервиса Stripe
STRIPE_WEBHOOK_SECRET= # вебхук-секрет сервиса Stripe

# Настройки Celery
CELERY_TASK_TRACK_STARTED= # Флаг отслеживания выполнения задач, по умолчанию используется true
CELERY_TASK_TIME_LIMIT= # Предел времени для обработки одной задачи в секундах, по умолчанию используется 1800 (1/2 часа)

# Параметры подключения к SMTP-серверу для организации рассылок электронных писем
EMAIL_HOST= # Адрес SMTP-сервера
EMAIL_PORT= # Порт для TLS-соединения, по умолчанию используется 587
EMAIL_USE_TLS= # Использование TLS-протокола шифрования, по умолчанию используется True
EMAIL_USE_SSL= # Использование SSL-протокола шифрования, по умолчанию используется False
EMAIL_HOST_USER= # Ваш email, должен соответствовать значению EMAIL_HOST
EMAIL_HOST_PASSWORD= # Пароль приложения
SENDING_INTERVAL = # Продолжительность задержки в секундах между отправками писем, по умолчанию используется 300

# Безопасность
CSRF_TRUSTED_ORIGINS= # Список доверенных доменов, значения ввести через запятую и без пробелов
    # Пример: CSRF_TRUSTED_ORIGINS=http://12.34.56.78,https://12.34.56.78,http://localhost

# Тестирование
TEST_MODE= # Флаг для установки фиксированных тестовых настроек подключения к БД и SMTP-серверу
    # Также устанавливает DEBUG=True и тестовое значение для SECRET_KEY
    # По умолчанию имеет значение False